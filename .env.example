# Copy to .env and fill in. Never commit .env.
TAVUS_API_KEY=
# Written by `npm run setup`:
TAVUS_PAL_ID=
# Optional: a face/replica id from your Tavus account (defaults to a stock face)
TAVUS_FACE_ID=
# Optional: LLM model (leave empty for the account default, e.g. tavus-gemma)
TAVUS_LLM_MODEL=
# Interview length in seconds: the one setting for call length (Tavus max_call_duration, the
# on-screen countdown, the 1-minute wrap-up and the spoken intro all read it).
# Demo: 480 (8 min) to protect the trial minutes. Real screening: 1800-2700 (30-45 min).
TAVUS_MAX_CALL_SECONDS=480
# What the session covers: screen = requirements + high-level design (fits 8 min),
# full = every area (use with 1800-2700 s). Out-of-scope rubric items are shown as "not in scope".
INTERVIEW_SCOPE=screen
# Reviewer-only attention notes from Raven (looked away / someone else appeared). off to disable.
ATTENTION_SIGNAL=on
# Optional: hiring company name shown on the start screen and said in the intro
COMPANY_NAME=
PORT=5173
# The interviewer's name (said in the intro). Re-run `npm run setup` after changing it.
INTERVIEWER_NAME=Anna
# Question used for every run (cancel-winback | rideshare | url-shortener | random)
DEFAULT_QUESTION=cancel-winback
